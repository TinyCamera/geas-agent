{
  "name": "geas-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agent harness for Geas multiplayer RPG. MCP client that drives a character on behalf of the user.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "dev:server": "tsx watch src/index-server.ts",
    "start": "node dist/index.js",
    "start:server": "node dist/index-server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:retry": "vitest run --config vitest.integration.config.ts tests/integration/retry-layer.live.test.ts",
    "lint": "tsc --noEmit",
    "repl": "tsx src/repl/cli.ts",
    "scenario": "tsx src/scenarios/cli.ts",
    "scenario:goblin-hunt": "tsx src/scenarios/cli.ts goblin-hunt"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.0"
  }
}
